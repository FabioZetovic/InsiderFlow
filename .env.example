# Copy to .env and fill in. `.env` is gitignored — never commit real secrets.

# MongoDB credentials (compose creates this user on a fresh volume)
MONGO_USER=insiderflow
MONGO_PASSWORD=change-me-to-a-long-random-string

# JWT signing secret — MUST be long & random for persistent, unforgeable sessions (>= 64 chars)
JWT_SECRET=change-me-to-a-64-char-random-string

# Finnhub free-tier API key (https://finnhub.io) — market quotes/earnings
FINNHUB_API_KEY=

# Comma-separated allowed frontend origins for CORS (prod: your Vercel URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend build-time API base URL (prod: your backend URL, e.g. https://api.example.com)
VITE_API_URL=http://localhost:8080

# SEC EDGAR requires a descriptive User-Agent with a real contact
SEC_USER_AGENT=InsiderFlow/1.0 (your-email@example.com)
