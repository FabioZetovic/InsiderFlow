meta {
  name: Wrong password is rejected
  type: http
  seq: 3
}
post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}
body:json {
  { "email": "{{testEmail}}", "password": "WrongPass9" }
}
tests {
  test("returns 401", function(){ expect(res.getStatus()).to.equal(401); });
  test("generic message (no enumeration)", function(){ expect(res.getBody().message).to.match(/invalid email or password/i); });
}
