meta {
  name: Toggle add ticker
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/api/watchlist/toggle
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
body:json {
  { "type": "ticker", "value": "NVDA" }
}
tests {
  test("status 200", function(){ expect(res.getStatus()).to.equal(200); });
  test("returns updated tickers", function(){ expect(res.getBody().tickers).to.be.an("array"); });
}
