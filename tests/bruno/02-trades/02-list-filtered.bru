meta {
  name: List filtered (senate buys)
  type: http
  seq: 2
}
get {
  url: {{baseUrl}}/api/trades?chamber=SENATE&type=BUY&size=3
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
tests {
  test("status 200", function(){ expect(res.getStatus()).to.equal(200); });
  test("all senate buys", function(){ res.getBody().content.forEach(t => { expect(t.chamber).to.equal("SENATE"); expect(t.transactionType).to.equal("BUY"); }); });
}
