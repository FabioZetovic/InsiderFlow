meta {
  name: List trades
  type: http
  seq: 1
}
get {
  url: {{baseUrl}}/api/trades?size=5
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
tests {
  test("status 200", function(){ expect(res.getStatus()).to.equal(200); });
  test("content is array", function(){ expect(res.getBody().content).to.be.an("array"); });
  test("has totalElements", function(){ expect(res.getBody().totalElements).to.be.a("number"); });
}
