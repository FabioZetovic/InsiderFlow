meta {
  name: Digest
  type: http
  seq: 12
}
get {
  url: {{baseUrl}}/api/trades/digest
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
tests {
  test("status 200", function(){ expect(res.getStatus()).to.equal(200); });
  test("has counts", function(){ expect(res.getBody().newTrades).to.be.a("number"); });
}
